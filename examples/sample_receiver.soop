  time_system: "GPST"
  time_format: "gps_seconds"
  columns:
    - epoch
    - sat_id
    - norad_id
    - constellation
    - azimuth_deg
    - elevation_deg
    - value
    - sigma
    - cn0_dBHz
    - tone_index
    - quality_flag
receiver:
  sdr:
    type: "HackRF One"
    sampling_rate_hz: 2000000
    sample_bits: 8
    bandwidth_hz: 2000000
  antenna:
    type: "parabolic_dish+LNBF"
